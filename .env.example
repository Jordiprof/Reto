# Plantilla de variables de entorno.
# Copia este archivo como .env y rellena tus claves reales:
#   copy .env.example .env   (Windows)
# El .env NUNCA se sube a git (esta plantilla si).

# --- Claves API (secretos) ---
OLLAMA_API_KEY=tu_clave_de_ollama_aqui
GROQ_API_KEY=tu_clave_de_groq_aqui
ANTHROPIC_API_KEY=tu_clave_de_anthropic_aqui

# --- Modelos por defecto (configuracion, no secreto) ---
# Ollama: verificado 15/07/2026 en docs oficiales — el free tier limita por cuota
# de uso (no por catalogo), asi que usamos un modelo ligero (nivel 1) con tools.
OLLAMA_MODEL=gpt-oss:20b
# Groq y Anthropic: placeholders razonables, se validan en Fase 1 (ADR-001).
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
