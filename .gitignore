# Secretos — NUNCA subir (la API key vive aqui)
.env

# Entorno virtual (cada maquina crea el suyo)
venv/

# Cache de Python (ficheros compilados, se regeneran solos)
__pycache__/
*.pyc

# Logs locales
logs/

# Conversaciones guardadas (datos personales, no codigo)
conversations/
conversations.db

# Cache de pytest (se regenera solo en cada ejecucion)
.pytest_cache/

# F5.3: indice vectorial de ChromaDB (datos DERIVADOS de las conversaciones
# personales - NUNCA a git, RNF-06) y cache del modelo de embeddings (pesa
# ~220MB, se descarga solo la primera vez).
chroma_db/
.modelos_cache/

# Copias de seguridad al "empezar de cero" (contienen conversaciones
# personales igual que los originales - nunca a git).
*.bak
*.bak/
